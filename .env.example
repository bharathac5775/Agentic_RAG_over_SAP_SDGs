# =============================================================================
# Agentic RAG over SAP SDGs — environment template
# =============================================================================
# 1. Copy this file to .env (which is gitignored — never commit .env).
# 2. Edit values as needed for your provider.
# 3. The defaults work for fully-local Ollama with no API keys.
#
# DO NOT commit real API keys to this repo. Ever.
# =============================================================================


# ---- Provider selection ----------------------------------------------------
# Which provider serves chat (router, generator, verifier, guardrail)?
# Options: ollama (default) | openai | anthropic | google
LLM_PROVIDER=ollama

# Which provider serves embeddings? Defaults to LLM_PROVIDER if unset.
# Common production pattern: embed locally (cheap), generate via cloud.
# EMBED_PROVIDER=ollama


# ---- Model name overrides --------------------------------------------------
# Defaults are Ollama models. Override per provider when switching.
#
# Local Ollama (default):
#   MODEL_GEN=llama3.1:8b
#   MODEL_SMALL=llama3.2:latest
#   MODEL_EMBED=nomic-embed-text
#
# OpenAI:
#   MODEL_GEN=gpt-4o-mini
#   MODEL_SMALL=gpt-4o-mini
#   MODEL_EMBED=text-embedding-3-small
#
# Anthropic (Claude — chat only; pair with another EMBED_PROVIDER):
#   MODEL_GEN=claude-haiku-4-5
#   MODEL_SMALL=claude-haiku-4-5
#
# Google (Gemini):
#   MODEL_GEN=gemini-2.0-flash
#   MODEL_SMALL=gemini-2.0-flash
#   MODEL_EMBED=text-embedding-004


# ---- Cloud provider keys ---------------------------------------------------
# Set ONLY the one(s) you actually use. Leave the others blank or remove
# them. Never commit real values.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=


# ---- Docker / Ollama host --------------------------------------------------
# Where the app reaches the Ollama server. Only relevant when LLM_PROVIDER=ollama.
#
# Native (no Docker):           leave unset — the ollama lib defaults to
#                                http://localhost:11434
#
# Docker, app-only on Mac/Win:  http://host.docker.internal:11434
#                                (Ollama runs on the host with GPU access)
#
# docker-compose with-ollama:   http://ollama:11434
#                                (set automatically by the compose file)
#
# OLLAMA_HOST=


# ---- Misc -----------------------------------------------------------------
# Hard cap on the chat-call context window. Raising this on memory-
# constrained hosts will trigger swapping. See app/config.py for the
# rationale (8K is 2× headroom over our largest real prompt).
# NUM_CTX=8192
